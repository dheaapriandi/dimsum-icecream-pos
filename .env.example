# ============================================
# Konfigurasi Supabase (wajib untuk build APK)
# ============================================
# Ambil dari dashboard Supabase:
# Project Settings -> API -> Project URL & anon public key
#
# Salin file ini menjadi ".env" lalu isi nilainya.
# File ".env" TIDAK ikut ter-commit (sudah ada di .gitignore).

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxx

# Catatan:
# - Anon key memang dirancang untuk dipakai di aplikasi client.
# - Jangan pernah memakai "service_role key" di aplikasi/APK.
# - Akses web sudah ditutup di level aplikasi; APK hanya bisa dibuka
#   dari perangkat Android (lihat README bagian "Akses Web Ditutup").
